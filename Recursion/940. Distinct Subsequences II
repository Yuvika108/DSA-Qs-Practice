class Solution {
public:
    int distinctSubseqII(string s) {
        const int MOD = 1e9 + 7;
        
        vector<long long> last(26, 0);
        long long total = 0;

        for (char c : s) {
            int idx = c - 'a';
            
            long long added = (1 + total - last[idx] + MOD) % MOD;
            
            last[idx] = (last[idx] + added) % MOD;
            
            total = (total + added) % MOD;
        }

        return total;
    }
};
